{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": [
		"src/index.ts",
		"src/loader.ts",
		"src/scheduler.ts",
		"src/gate.ts",
		"src/errors.ts",
		"src/bindgen.ts",
		"src/bundler.ts",
		"src/cartridge.ts"
	],
	"out": "typedoc",
	"name": "bytebox",
	"readme": "./README.md",
	"includeVersion": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"validation": { "notExported": true, "invalidLink": true, "notDocumented": true },
	"treatWarningsAsErrors": false
}
